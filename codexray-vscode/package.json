{
  "name": "codexray",
  "displayName": "CodeXray",
  "description": "A source-code X-ray for manual security review of Python. Not a scanner — surfaces entry points, sinks, taint sources, blind spots, and a coverage ledger. The analyst decides.",
  "version": "0.1.0",
  "publisher": "codexray",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashwanthgk88/codexray"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "security",
    "python",
    "audit",
    "sast",
    "code review"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexray.analyzeWorkspace",
        "title": "CodeXray: X-ray Workspace",
        "category": "CodeXray"
      },
      {
        "command": "codexray.analyzeFolder",
        "title": "CodeXray: X-ray This Folder",
        "category": "CodeXray"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codexray.analyzeFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "vsce:package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.22.6",
    "tree-sitter-wasms": "^0.1.11"
  }
}
