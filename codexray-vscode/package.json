{
  "name": "codexray",
  "displayName": "CodeXray",
  "description": "A source-code X-ray for manual security review of Python. Not a scanner — surfaces entry points, sinks, taint sources, blind spots, and a coverage ledger. The analyst decides.",
  "version": "0.1.2",
  "publisher": "codexray",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashwanthgk88/codexray"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "security",
    "python",
    "audit",
    "sast",
    "code review"
  ],
  "activationEvents": [
    "onCommand:codexray.analyzeWorkspace",
    "onCommand:codexray.analyzeFolder",
    "onView:codexray.panel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexray",
          "title": "CodeXray",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codexray": [
        {
          "id": "codexray.panel",
          "name": "X-ray",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexray.panel",
        "contents": "A source-code X-ray for manual security review of Python — not a scanner.\n\n[$(search) X-ray Workspace](command:codexray.analyzeWorkspace)\n\nOr right-click any folder in the Explorer → CodeXray: X-ray This Folder."
      }
    ],
    "commands": [
      {
        "command": "codexray.analyzeWorkspace",
        "title": "X-ray Workspace",
        "category": "CodeXray",
        "icon": "$(search)"
      },
      {
        "command": "codexray.analyzeFolder",
        "title": "X-ray This Folder",
        "category": "CodeXray"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codexray.analyzeFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "codexray.analyzeWorkspace",
          "when": "view == codexray.panel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "package": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "vsce:package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.75.1",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.22.6"
  }
}
